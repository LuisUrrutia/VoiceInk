// LocalBuild.xcconfig
// Build configuration for local builds with an ad-hoc fallback when no stable signing identity is available.
// Applied by `make local` and `make local-build` on top of Release; normal Xcode configurations are unchanged.

// make local selects a stable signing identity or the ad-hoc fallback.
// Leave CODE_SIGN_IDENTITY unset here: -xcconfig overrides command-line settings.
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =

// Entitlements are set via absolute path in the Makefile command line
// (relative paths break SPM package targets that resolve from their own source root)

// Add LOCAL_BUILD compilation flag so Swift code can use #if LOCAL_BUILD
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) LOCAL_BUILD
